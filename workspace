#!/usr/bin/env bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

CONFIG_FILE="$HOME/.workspaces.yml"

# Caddy routes <feature>.<project>.test hostnames to each workspace's Rails
# port. One snippet per workspace lives in the caddy dir, which Homebrew's
# Caddyfile imports. Both paths can be overridden with top-level `caddy_dir:`
# and `caddyfile:` keys in ~/.workspaces.yml.
DEFAULT_CADDY_DIR="$HOME/.workspaces/caddy"
DEFAULT_CADDYFILE="/opt/homebrew/etc/Caddyfile"

# ============================================================================
# Config parsing functions
# ============================================================================

check_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo -e "${RED}Error: Config file not found at $CONFIG_FILE${NC}"
        echo ""
        echo "Create it with the following format:"
        echo ""
        echo "projects:"
        echo "  myproject:"
        echo "    path: ~/projects/myproject/app"
        echo "    worktree_dir: ~/projects/myproject"
        exit 1
    fi
}

# Simple YAML parser for our specific format
# Gets a project's path or worktree_dir
get_project_config() {
    local project="$1"
    local key="$2"

    # Parse the YAML file to find the project section and extract the key
    awk -v proj="$project" -v key="$key" '
        /^  [a-zA-Z_-]+:$/ {
            current_project = $1
            gsub(/:$/, "", current_project)
        }
        current_project == proj && $1 == key":" {
            # Get value after the key, trim whitespace and comments
            val = $0
            sub(/^[^:]+:[ \t]*/, "", val)
            sub(/[ \t]*#.*$/, "", val)
            print val
            exit
        }
    ' "$CONFIG_FILE"
}

# Read a top-level (non-project) key from the config file
get_top_config() {
    awk -v key="$1" '
        $0 ~ "^"key":" {
            val = $0
            sub(/^[^:]+:[ \t]*/, "", val)
            sub(/[ \t]*#.*$/, "", val)
            print val
            exit
        }
    ' "$CONFIG_FILE" 2>/dev/null
}

# Expand ~ to $HOME
expand_path() {
    local path="$1"
    echo "${path/#\~/$HOME}"
}

# Copy the gitignored Rails master.key from the main checkout into a new
# worktree. Without it, apps that keep secrets in credentials.yml.enc (e.g.
# Active Record encryption keys) fail at boot / in tests. Skips silently when
# the main checkout has no key; never overwrites one already in the worktree.
copy_master_key() {
    local workspace_dir="$1"
    if [[ -f "$PROJECT_PATH/config/master.key" && ! -f "$workspace_dir/config/master.key" ]]; then
        echo -e "${YELLOW}Copying master.key...${NC}"
        mkdir -p "$workspace_dir/config"
        cp "$PROJECT_PATH/config/master.key" "$workspace_dir/config/master.key"
    fi
}

# List all configured projects
list_projects() {
    awk '/^  [a-zA-Z_-]+:$/ {
        proj = $1
        gsub(/:$/, "", proj)
        print proj
    }' "$CONFIG_FILE"
}

# Validate project exists in config
validate_project() {
    local project="$1"
    local projects
    projects=$(list_projects)

    if ! echo "$projects" | grep -qx "$project"; then
        echo -e "${RED}Error: Unknown project '$project'${NC}"
        echo ""
        echo "Available projects:"
        echo "$projects" | sed 's/^/  /'
        exit 1
    fi
}

# Get project paths
get_project_paths() {
    local project="$1"

    PROJECT_PATH=$(expand_path "$(get_project_config "$project" "path")")
    WORKTREE_DIR=$(expand_path "$(get_project_config "$project" "worktree_dir")")

    local redis_val
    redis_val=$(get_project_config "$project" "redis")
    if [[ "$redis_val" == "false" ]]; then
        USES_REDIS=false
    else
        USES_REDIS=true
    fi

    if [[ -z "$PROJECT_PATH" ]] || [[ -z "$WORKTREE_DIR" ]]; then
        echo -e "${RED}Error: Project '$project' is missing path or worktree_dir in config${NC}"
        exit 1
    fi

    if [[ ! -d "$PROJECT_PATH" ]]; then
        echo -e "${RED}Error: Project path does not exist: $PROJECT_PATH${NC}"
        exit 1
    fi
}

# Sanitize a branch/feature name for use as a directory name (replace / with -)
sanitize_dir_name() {
    echo "${1//\//-}"
}

# Rails port recorded in a workspace's .env. Legacy workspaces only recorded
# VITE_RUBY_PORT, which is always RAILS_PORT + 2. Empty if neither is set.
workspace_rails_port() {
    local env_file="$1/.env"
    [[ -f "$env_file" ]] || return 0
    local port
    port=$(grep '^RAILS_PORT=' "$env_file" | cut -d= -f2 | tr -d '"' || true)
    if [[ -z "$port" ]]; then
        local vite_port
        vite_port=$(grep '^VITE_RUBY_PORT=' "$env_file" | cut -d= -f2 | tr -d '"' || true)
        if [[ -n "$vite_port" ]]; then
            port=$((vite_port - 2))
        fi
    fi
    echo "$port"
}

# Strip any earlier workspace-specific vars from .env, append the fresh set,
# and write the .env.test that forces Vite to compile instead of proxying to
# the dev server.
write_workspace_env() {
    local workspace_dir="$1"
    local rails_port="$2"
    local vite_port="$3"
    local session_cookie="$4"
    local redis_db="$5"

    echo -e "${YELLOW}Configuring .env...${NC}"
    if [[ -f "$workspace_dir/.env" ]]; then
        grep -v '^RAILS_PORT=' "$workspace_dir/.env" | grep -v '^SESSION_COOKIE_NAME=' | grep -v '^VITE_RUBY_PORT=' | grep -v '^REDIS_URL=' > "$workspace_dir/.env.tmp" || true
        mv "$workspace_dir/.env.tmp" "$workspace_dir/.env"
    fi

    cat >> "$workspace_dir/.env" << EOF

# Workspace-specific settings
RAILS_PORT=$rails_port
VITE_RUBY_PORT=$vite_port
SESSION_COOKIE_NAME="$session_cookie"
EOF
    if [[ -n "$redis_db" ]]; then
        echo "REDIS_URL=redis://localhost:6379/$redis_db" >> "$workspace_dir/.env"
    fi

    cat > "$workspace_dir/.env.test" << EOF
VITE_RUBY_PORT=3037
EOF
}

# Feature scratchpad lives under tmp/ so it never overwrites committed docs
# and the delete-time docs/local rescue doesn't prompt over throwaway notes.
scratchpad_path() {
    local workspace_dir="$1"
    local feature="$2"
    echo "$workspace_dir/tmp/$(sanitize_dir_name "$feature").md"
}

# Standard notice embedded in every scratchpad stub so coding agents don't
# mistake it for a place to write documentation.
scratchpad_notice() {
    echo "> Jess's scratch pad — throwaway notes only. Agents: do not write documentation here; update an existing doc in docs/ (index: docs/README.md) or create a new one there via /docs."
}

# Prefer tmp/; fall back to legacy docs/local/<feature>.md and docs/<feature>.md
# from older workspaces.
resolve_scratchpad() {
    local workspace_dir="$1"
    local feature="$2"
    local preferred legacy
    preferred=$(scratchpad_path "$workspace_dir" "$feature")
    if [[ -f "$preferred" ]]; then
        echo "$preferred"
        return
    fi
    legacy="$workspace_dir/docs/local/$(sanitize_dir_name "$feature").md"
    if [[ -f "$legacy" ]]; then
        echo "$legacy"
        return
    fi
    legacy="$workspace_dir/docs/$(sanitize_dir_name "$feature").md"
    if [[ -f "$legacy" ]]; then
        echo "$legacy"
        return
    fi
    # Nested legacy path for branch names that contained '/'
    if [[ "$feature" == */* && -f "$workspace_dir/docs/$feature.md" ]]; then
        echo "$workspace_dir/docs/$feature.md"
        return
    fi
    echo "$preferred"
}

# Check if the feature name refers to the main/master workspace
is_main_workspace() {
    local feature="$1"
    [[ "$feature" == "main" || "$feature" == "master" ]]
}

# Detect the default branch for a project (main or master)
default_branch() {
    local ref
    ref=$(git -C "$PROJECT_PATH" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null)
    if [[ -n "$ref" ]]; then
        echo "${ref##*/}"
        return
    fi
    # Fallback: check which branch exists on origin
    if git -C "$PROJECT_PATH" rev-parse --verify origin/main &>/dev/null; then
        echo "main"
    else
        echo "master"
    fi
}

# Display a banner in a tmux pane. Writes a self-deleting script to avoid
# send-keys line-length issues with long printf strings.
show_banner() {
    local tmux_target="$1"
    local workspace_dir="$2"
    local project="$3"
    local label="$4"
    local server="$5"
    local host_url="${6:-}"

    # Extra "Host:" line when the workspace has a Caddy hostname. The URL is
    # spliced into the printf format, which is safe: it never contains % or \.
    local host_line=""
    if [[ -n "$host_url" ]]; then
        host_line="\nHost:    $host_url"
    fi

    cat > "$workspace_dir/.show-banner.sh" << BANNER_SCRIPT
#!/usr/bin/env bash
clear
printf "Project: %s\n%s\nServer:  %s$host_line" "$project" "$label" "$server" \
    | gum style --border rounded --border-foreground "#7D56F4" --padding "0 1"
rm -f "\$0"
BANNER_SCRIPT
    chmod +x "$workspace_dir/.show-banner.sh"
    tmux send-keys -t "$tmux_target" "./.show-banner.sh" C-m
}

# Find the next available Redis DB number (1-15) by scanning ALL projects' worktrees
next_free_redis_db() {
    local used_dbs=""     # every DB claimed by any worktree (running or not)
    local running_dbs=""  # DBs claimed by worktrees whose tmux session is live

    # Scan worktrees across all configured projects (they share the same Redis)
    for project in $(list_projects); do
        local proj_path
        proj_path=$(expand_path "$(get_project_config "$project" "path")")
        [[ -d "$proj_path" ]] || continue

        while IFS= read -r line; do
            local wt_path db session
            wt_path=$(echo "$line" | awk '{print $1}')
            [[ -f "$wt_path/.env" ]] || continue
            db=$(grep '^REDIS_URL=' "$wt_path/.env" | sed 's|.*redis://[^/]*/||' | tr -d '"' || true)
            [[ -n "$db" ]] || continue
            used_dbs="$used_dbs $db"

            # Match the tmux naming used at creation: "<project>-main" for the
            # primary worktree, "<project>-<dirname>" for feature worktrees.
            if [[ "$wt_path" == "$proj_path" ]]; then
                session="${project}-main"
            else
                session="${project}-$(basename "$wt_path")"
            fi
            if tmux has-session -t "$session" 2>/dev/null; then
                running_dbs="$running_dbs $db"
            fi
        done <<< "$(git -C "$proj_path" worktree list 2>/dev/null)"
    done

    # Prefer a DB that no worktree has claimed at all — a clean, guaranteed
    # collision-free slot.
    for db in $(seq 1 15); do
        if ! echo "$used_dbs" | grep -qw "$db"; then
            echo "$db"
            return
        fi
    done

    # Pool exhausted: every DB is claimed by some (often idle) worktree. Rather
    # than always recycling DB 1, pick the DB least likely to collide with
    # active work: avoid DBs used by running workspaces, then break ties toward
    # the least-crowded DB so repeated allocations spread out instead of piling
    # onto one number.
    local best_db="" best_score=""
    for db in $(seq 1 15); do
        local running_count total_count score
        running_count=$(echo "$running_dbs" | grep -ow "$db" | wc -l | tr -d ' ')
        total_count=$(echo "$used_dbs" | grep -ow "$db" | wc -l | tr -d ' ')
        # Weight running collisions heavily so any DB free of running work wins
        # over any DB that's in active use.
        score=$((running_count * 100 + total_count))
        if [[ -z "$best_score" || "$score" -lt "$best_score" ]]; then
            best_score="$score"
            best_db="$db"
        fi
    done

    if [[ "$best_score" -ge 100 ]]; then
        echo -e "${YELLOW}Warning: all Redis DBs (1-15) are in use by running workspaces; reusing DB $best_db${NC}" >&2
    else
        echo -e "${YELLOW}Note: all Redis DBs (1-15) are assigned; reusing DB $best_db (not used by any running workspace)${NC}" >&2
    fi
    echo "$best_db"
}

# Find an unused port by scanning ALL projects' worktrees for RAILS_PORT and VITE_RUBY_PORT
next_free_port() {
    local used_ports=""

    for project in $(list_projects); do
        local proj_path
        proj_path=$(expand_path "$(get_project_config "$project" "path")")
        [[ -d "$proj_path" ]] || continue

        while IFS= read -r line; do
            local wt_path
            wt_path=$(echo "$line" | awk '{print $1}')
            if [[ -f "$wt_path/.env" ]]; then
                local port
                port=$(grep '^RAILS_PORT=' "$wt_path/.env" | cut -d= -f2 | tr -d '"' || true)
                if [[ -n "$port" ]]; then
                    used_ports="$used_ports $port $((port + 2))"
                fi
                # Also check legacy VITE_RUBY_PORT-only workspaces
                if [[ -z "$port" ]]; then
                    port=$(grep '^VITE_RUBY_PORT=' "$wt_path/.env" | cut -d= -f2 | tr -d '"' || true)
                    if [[ -n "$port" ]]; then
                        used_ports="$used_ports $port $((port - 2))"
                    fi
                fi
            fi
        done <<< "$(git -C "$proj_path" worktree list 2>/dev/null)"
    done

    local attempts=0
    while (( attempts < 50 )); do
        local candidate=$((3100 + RANDOM % 800))
        if ! echo "$used_ports" | grep -qw "$candidate" && \
           ! echo "$used_ports" | grep -qw "$((candidate + 2))"; then
            echo "$candidate"
            return
        fi
        ((attempts++))
    done

    echo -e "${RED}Warning: Could not find an unused port after 50 attempts${NC}" >&2
    echo "$((3100 + RANDOM % 800))"
}

# Resolve the actual worktree path for a feature.
# If the config-derived path isn't a worktree, search git worktree list by branch name.
resolve_worktree_path() {
    local project="$1"
    local feature="$2"
    local config_dir="$WORKTREE_DIR/$(sanitize_dir_name "$feature")"

    # Check if the config-derived path is a known worktree
    if git -C "$PROJECT_PATH" worktree list | grep -q "^$config_dir "; then
        echo "$config_dir"
        return
    fi

    # Fall back: search by directory name or branch name
    local found_path
    found_path=$(git -C "$PROJECT_PATH" worktree list | awk -v feat="/$feature " -v branch="[$feature]" '$0 ~ feat || $3 == branch {print $1; exit}')

    if [[ -n "$found_path" ]]; then
        echo "$found_path"
        return
    fi

    # Nothing found
    echo ""
}

# ============================================================================
# Caddy hostnames
# ============================================================================
#
# Every workspace gets a readable hostname on top of its localhost:<port> URL:
# <feature>.<project>.test, or main.<project>.test for the main checkout. The
# hostname key is the same one the tmux session uses (the worktree directory
# name, or "main"), so it stays stable if the branch inside a worktree changes.
#
# dnsmasq already resolves every *.test name to 127.0.0.1; Caddy listening on
# :80 does the other half, routing by Host header to the workspace's Rails
# port. One snippet file per workspace lives in the caddy dir and Homebrew's
# Caddyfile imports the whole directory. Ports are the source of truth — the
# snippets are derived from each worktree's .env and can be regenerated at any
# time with `workspace caddy-sync`.
#
# Caddy being absent, stopped, or unconfigured is only ever a warning: the
# localhost:<port> URL keeps working regardless.

CADDY_MANAGED_MARK="# Managed by workspace"

caddy_dir() {
    local dir
    dir=$(get_top_config "caddy_dir")
    expand_path "${dir:-$DEFAULT_CADDY_DIR}"
}

caddyfile_path() {
    local file
    file=$(get_top_config "caddyfile")
    expand_path "${file:-$DEFAULT_CADDYFILE}"
}

# Lowercase and reduce to [a-z0-9-] so a name like Feature/Foo_bar.v2 becomes
# one valid DNS label (feature-foo-bar-v2).
dns_label() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# <key>.<project>.test — key is "main" or the worktree directory name
workspace_hostname() {
    local project="$1"
    local key="$2"
    if is_main_workspace "$key"; then
        key="main"
    fi
    echo "$(dns_label "$key").$(dns_label "$project").test"
}

caddy_snippet_path() {
    local project="$1"
    local key="$2"
    if is_main_workspace "$key"; then
        key="main"
    fi
    echo "$(caddy_dir)/$(dns_label "$project")-$(dns_label "$key").caddy"
}

# Write the snippet for one workspace. Returns 0 if the file was created or
# changed (so the caller knows to reload), 1 if it was already up to date.
write_caddy_snippet() {
    local project="$1"
    local key="$2"
    local port="$3"
    local snippet hostname content
    snippet=$(caddy_snippet_path "$project" "$key")
    hostname=$(workspace_hostname "$project" "$key")
    content="$CADDY_MANAGED_MARK — regenerated by 'workspace caddy-sync'; edits will be lost.
http://$hostname {
	reverse_proxy localhost:$port
}"
    mkdir -p "$(dirname "$snippet")"
    if [[ -f "$snippet" ]] && [[ "$(cat "$snippet")" == "$content" ]]; then
        return 1
    fi
    printf '%s\n' "$content" > "$snippet"
    return 0
}

caddy_running() {
    curl -s -m 1 -o /dev/null http://localhost:2019/config/ 2>/dev/null
}

# Reload Caddy so added/removed snippets take effect. Never fails — every
# problem is a warning, because the port URL works without Caddy.
caddy_reload() {
    local caddyfile dir
    caddyfile=$(caddyfile_path)
    dir=$(caddy_dir)

    if ! command -v caddy &>/dev/null; then
        echo -e "${YELLOW}Caddy is not installed — hostname won't route (brew install caddy; see README)${NC}"
        return 0
    fi
    if ! grep -qs "^[[:space:]]*import $dir/" "$caddyfile"; then
        echo -e "${YELLOW}$caddyfile does not import $dir — hostname won't route (see README)${NC}"
        return 0
    fi
    if ! caddy_running; then
        echo -e "${YELLOW}Caddy is not running — hostname won't route until: brew services start caddy${NC}"
        return 0
    fi

    local output
    if output=$(caddy reload --config "$caddyfile" --adapter caddyfile 2>&1); then
        return 0
    fi
    echo -e "${YELLOW}Caddy reload failed — hostname may not route:${NC}"
    # Drop Caddy's JSON log lines; the trailing "Error: ..." line is the useful bit
    echo "$output" | grep -v '^{' | sed 's/^/  /'
    return 0
}

# Write (or refresh) a workspace's snippet and reload only if it changed
register_caddy_hostname() {
    local project="$1"
    local key="$2"
    local port="$3"
    if write_caddy_snippet "$project" "$key" "$port"; then
        caddy_reload
    fi
}

# Remove a workspace's snippet and reload; a no-op if there was none
unregister_caddy_hostname() {
    local snippet
    snippet=$(caddy_snippet_path "$1" "$2")
    [[ -f "$snippet" ]] || return 0
    rm -f "$snippet"
    caddy_reload
}

# ============================================================================
# Claude Code folder trust
# ============================================================================

# Claude Code shows its folder-trust dialog on first launch in every new
# worktree: each worktree is its own trust root, and trust never cascades from
# parent directories. Pre-seeding the trust entry in ~/.claude.json (top-level
# "projects" object, keyed by absolute path) lets scripted workspace sessions
# land straight in a working Claude session. hasTrustDialogAccepted is an
# undocumented key — if a future Claude Code changes it, the only failure mode
# is the trust prompt returning.
#
# Always returns 0 (a failed seed must never break workspace creation) and
# reports the outcome for the summary via CLAUDE_TRUST_SUMMARY.
claude_trust_edit() {
    local mode="$1"          # add | remove
    local worktree_path="$2"
    local claude_config="$HOME/.claude.json"
    CLAUDE_TRUST_SUMMARY="not pre-seeded (trust prompt will appear once)"

    if [[ ! -f "$claude_config" ]]; then
        [[ "$mode" == "add" ]] && echo -e "${YELLOW}Warning: $claude_config not found; Claude will show its trust prompt once.${NC}"
        return 0
    fi
    if ! command -v python3 &>/dev/null; then
        [[ "$mode" == "add" ]] && echo -e "${YELLOW}Warning: python3 not found; Claude will show its trust prompt once.${NC}"
        return 0
    fi

    # Match the key form Claude Code uses: absolute path, no trailing slash
    worktree_path="${worktree_path%/}"

    # ~/.claude.json is live config for running Claude sessions: write to a
    # tmp file (with matching permissions — the file holds account data) and
    # atomically replace, never truncate in place.
    if python3 - "$mode" "$worktree_path" <<'PY' 2>/dev/null
import json, os, sys
mode, path = sys.argv[1], sys.argv[2]
f = os.path.expanduser('~/.claude.json')
with open(f) as fh:
    d = json.load(fh)
if mode == 'add':
    d.setdefault('projects', {}).setdefault(path, {})['hasTrustDialogAccepted'] = True
else:
    d.get('projects', {}).pop(path, None)
tmp = f + '.tmp'
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, os.stat(f).st_mode & 0o777)
with os.fdopen(fd, 'w') as out:
    json.dump(d, out, indent=2)
os.replace(tmp, f)
PY
    then
        CLAUDE_TRUST_SUMMARY="pre-seeded"
    else
        if [[ "$mode" == "add" ]]; then
            echo -e "${YELLOW}Warning: could not pre-seed Claude trust; the trust prompt will appear once.${NC}"
        else
            echo -e "${YELLOW}Warning: could not remove Claude trust entry for $worktree_path${NC}"
        fi
    fi
    return 0
}

preseed_claude_trust() {
    echo -e "${YELLOW}Pre-seeding Claude Code folder trust...${NC}"
    claude_trust_edit add "$1"
}

remove_claude_trust() {
    claude_trust_edit remove "$1"
}

# ============================================================================
# Subcommand: new
# ============================================================================

cmd_new() {
    local project="$1"
    local feature="$2"
    local use_existing=false

    if [[ "$3" == "--existing" ]]; then
        use_existing=true
    fi

    if [[ -z "$project" ]] || [[ -z "$feature" ]]; then
        echo "Usage: workspace new <project> <feature> [--existing]"
        echo ""
        echo "Example: workspace new tract my-feature"
        echo "         workspace new tract my-feature --existing   # reuse existing branch"
        exit 1
    fi

    validate_project "$project"
    get_project_paths "$project"

    local is_main=false
    local workspace_dir

    if is_main_workspace "$feature"; then
        is_main=true
        workspace_dir="$PROJECT_PATH"

        # Check if already initialized
        if [[ -f "$workspace_dir/Procfile.workspace" ]]; then
            echo -e "${RED}Error: Main workspace already initialized${NC}"
            echo -e "Use ${YELLOW}workspace resume $project main${NC} to restart it."
            exit 1
        fi
    else
        workspace_dir="$WORKTREE_DIR/$(sanitize_dir_name "$feature")"

        # Check if directory already exists
        if [[ -d "$workspace_dir" ]]; then
            echo -e "${RED}Error: Directory $workspace_dir already exists${NC}"
            exit 1
        fi
    fi

    local rails_port
    rails_port=$(next_free_port)
    local vite_port=$((rails_port + 2))
    local server_url="http://localhost:$rails_port"
    local session_cookie="${project}_cookie_${rails_port}"
    local redis_db=""
    if [[ "$USES_REDIS" == "true" ]]; then
        redis_db=$(next_free_redis_db)
    fi

    # Hostname key: "main", or the worktree directory name (same key as tmux)
    local host_key="main"
    if [[ "$is_main" == false ]]; then
        host_key=$(basename "$workspace_dir")
    fi
    local host_url
    host_url="http://$(workspace_hostname "$project" "$host_key")"

    echo -e "${GREEN}Creating new workspace: $feature${NC}"
    echo -e "  Project:             $project"
    echo -e "  Workspace directory: $workspace_dir"
    echo -e "  Rails port:          $rails_port"
    echo -e "  Hostname:            $host_url"
    echo -e "  Vite port:           $vite_port"
    echo -e "  Session cookie:      $session_cookie"
    [[ -n "$redis_db" ]] && echo -e "  Redis DB:            $redis_db"
    echo ""

    if [[ "$is_main" == false ]]; then
        if [[ "$use_existing" == true ]]; then
            # Verify the branch exists locally
            if ! git -C "$PROJECT_PATH" show-ref --verify --quiet "refs/heads/$feature"; then
                echo -e "${RED}Error: Branch '$feature' does not exist locally${NC}"
                echo ""
                echo "Available local branches:"
                git -C "$PROJECT_PATH" branch --format='  %(refname:short)'
                exit 1
            fi

            # Create worktree from existing branch
            echo -e "${YELLOW}Using existing branch: $feature${NC}"
            echo -e "${YELLOW}Creating git worktree...${NC}"
            git -C "$PROJECT_PATH" worktree add "$workspace_dir" "$feature"
        else
            # Fetch latest and create new branch from origin
            local base_branch
            base_branch=$(default_branch)
            echo -e "${YELLOW}Fetching latest from origin/$base_branch...${NC}"
            git -C "$PROJECT_PATH" fetch origin "$base_branch"

            echo -e "${YELLOW}Creating git worktree...${NC}"
            git -C "$PROJECT_PATH" worktree add -b "$feature" "$workspace_dir" "origin/$base_branch"
        fi

        # Copy .env file if it exists in main workspace
        if [[ -f "$PROJECT_PATH/.env" ]]; then
            echo -e "${YELLOW}Copying .env file...${NC}"
            cp "$PROJECT_PATH/.env" "$workspace_dir/.env"
        fi

        copy_master_key "$workspace_dir"

        # Copy Claude Code settings so permissions carry over
        if [[ -f "$PROJECT_PATH/.claude/settings.local.json" ]]; then
            echo -e "${YELLOW}Copying Claude Code settings...${NC}"
            mkdir -p "$workspace_dir/.claude"
            cp "$PROJECT_PATH/.claude/settings.local.json" "$workspace_dir/.claude/settings.local.json"
        fi
    fi

    write_workspace_env "$workspace_dir" "$rails_port" "$vite_port" "$session_cookie" "$redis_db"

    # Register the hostname with Caddy (warning only if Caddy isn't around)
    register_caddy_hostname "$project" "$host_key" "$rails_port"

    # Create a workspace-specific Procfile
    echo -e "${YELLOW}Creating Procfile.workspace...${NC}"
    local procfile="$PROJECT_PATH/Procfile.workspace"
    local template_file="$PROJECT_PATH/Procfile.workspace.template"

    if [[ -f "$procfile" ]]; then
        cp "$procfile" "$workspace_dir/Procfile.workspace"
    elif [[ -f "$template_file" ]]; then
        cp "$template_file" "$workspace_dir/Procfile.workspace"
    else
        # Default Rails Procfile — reads ports from .env
        cat > "$workspace_dir/Procfile.workspace" << 'EOF'
web: RUBY_DEBUG_OPEN=true bin/rails server -p $RAILS_PORT
vite: bin/vite dev
worker: RUBY_DEBUG_OPEN=true bundle exec sidekiq -C config/sidekiq.yml
EOF
    fi

    if [[ "$is_main" == false ]]; then
        preseed_claude_trust "$workspace_dir"
    fi

    # Create tmux session (keyed off the directory name so it stays stable
    # even if the branch inside the worktree later changes)
    local session_name
    if [[ "$is_main" == true ]]; then
        session_name="main"
    else
        session_name=$(basename "$workspace_dir")
    fi
    local tmux_session="${project}-${session_name}"
    echo -e "${YELLOW}Creating tmux session: $tmux_session${NC}"

    local notes_file=""
    if [[ "$is_main" == false ]]; then
        # Create feature scratchpad under tmp/
        notes_file=$(scratchpad_path "$workspace_dir" "$feature")
        mkdir -p "$(dirname "$notes_file")"
        if [[ ! -f "$notes_file" ]]; then
            cat > "$notes_file" << EOF
# New Feature - $feature

---
Server URL:  $server_url
Hostname:    $host_url
Git branch:  $feature
Path:        $workspace_dir
---

$(scratchpad_notice)

Start describing your new feature...
EOF
        fi
    fi

    # Create tmux session with first window for coding
    tmux new-session -d -s "$tmux_session" -c "$workspace_dir" -n "code"

    # Split first window vertically: vim on left, shell on right
    if [[ "$is_main" == false ]]; then
        tmux send-keys -t "$tmux_session:code" "vim \"$notes_file\"" C-m
    else
        tmux send-keys -t "$tmux_session:code" "vim" C-m
    fi
    tmux split-window -h -t "$tmux_session:code" -c "$workspace_dir"

    # Display banner in shell pane
    if [[ "$is_main" == true ]]; then
        show_banner "$tmux_session:code.1" "$workspace_dir" "$project" "Branch:  main" "$server_url" "$host_url"
    else
        show_banner "$tmux_session:code.1" "$workspace_dir" "$project" "Feature: $feature" "$server_url" "$host_url"
    fi

    # Create second window for server
    tmux new-window -t "$tmux_session" -c "$workspace_dir" -n "server"

    # Create a setup script that runs in the server window
    cat > "$workspace_dir/.workspace-setup.sh" << 'SETUP_SCRIPT'
#!/usr/bin/env bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Setting up node version...${NC}"
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use

echo -e "${YELLOW}Installing dependencies...${NC}"
echo -e "  Running bundle install..."
if ! bundle install; then
    echo -e "${RED}bundle install failed${NC}"
    exit 1
fi

echo -e "  Running yarn install..."
if ! yarn install; then
    echo -e "${RED}yarn install failed${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}Setup complete!${NC}"
echo ""
SETUP_SCRIPT

    # Append cleanup to the setup script
    cat >> "$workspace_dir/.workspace-setup.sh" << 'EOF'
rm -f "$0"  # Clean up this script
EOF

    chmod +x "$workspace_dir/.workspace-setup.sh"

    # Run setup then start overmind. The setup script self-deletes, so on
    # subsequent up-arrow replays the test -x silently skips it.
    tmux send-keys -t "$tmux_session:server" "test -x ./.workspace-setup.sh && ./.workspace-setup.sh; overmind start -f Procfile.workspace" C-m

    # Go back to first window, focus on vim pane
    tmux select-window -t "$tmux_session:code"
    tmux select-pane -t "$tmux_session:code.0"

    echo ""
    echo -e "${GREEN}Workspace created!${NC}"
    echo ""
    echo -e "  Tmux session: ${YELLOW}$tmux_session${NC}"
    echo -e "  Server URL:   ${YELLOW}$server_url${NC}"
    echo -e "  Hostname:     ${YELLOW}$host_url${NC}"
    if [[ "$is_main" == false ]]; then
        echo -e "  Claude trust: $CLAUDE_TRUST_SUMMARY"
    fi
    echo ""
    echo -e "Switch to session:"
    echo -e "  ${YELLOW}tmux switch-client -t $tmux_session${NC}"
    echo ""
    echo -e "Or if not in tmux:"
    echo -e "  ${YELLOW}tmux attach -t $tmux_session${NC}"
    if [[ "$is_main" == false ]]; then
        echo ""
        echo -e "To delete this workspace later:"
        echo -e "  ${YELLOW}workspace delete $project $feature${NC}"
    fi
}

# ============================================================================
# Subcommand: pull
# ============================================================================

cmd_pull() {
    local project="$1"
    local branch="$2"

    if [[ -z "$project" ]] || [[ -z "$branch" ]]; then
        echo "Usage: workspace pull <project> <branch>"
        echo ""
        echo "Example: workspace pull tract remote-branch"
        exit 1
    fi

    validate_project "$project"
    get_project_paths "$project"

    local workspace_dir="$WORKTREE_DIR/$(sanitize_dir_name "$branch")"

    # Check if directory already exists
    if [[ -d "$workspace_dir" ]]; then
        echo -e "${RED}Error: Directory $workspace_dir already exists${NC}"
        exit 1
    fi

    local rails_port
    rails_port=$(next_free_port)
    local vite_port=$((rails_port + 2))
    local server_url="http://localhost:$rails_port"
    local session_cookie="${project}_cookie_${rails_port}"
    local host_key host_url
    host_key=$(basename "$workspace_dir")
    host_url="http://$(workspace_hostname "$project" "$host_key")"

    local redis_db=""
    if [[ "$USES_REDIS" == "true" ]]; then
        redis_db=$(next_free_redis_db)
    fi

    echo -e "${GREEN}Pulling remote branch: $branch${NC}"
    echo -e "  Project:             $project"
    echo -e "  Workspace directory: $workspace_dir"
    echo -e "  Rails port:          $rails_port"
    echo -e "  Hostname:            $host_url"
    echo -e "  Vite port:           $vite_port"
    echo -e "  Session cookie:      $session_cookie"
    [[ -n "$redis_db" ]] && echo -e "  Redis DB:            $redis_db"
    echo ""

    # Fetch the remote branch
    echo -e "${YELLOW}Fetching branch from origin...${NC}"
    git -C "$PROJECT_PATH" fetch origin "$branch"

    # Create worktree tracking the remote branch
    echo -e "${YELLOW}Creating git worktree...${NC}"
    git -C "$PROJECT_PATH" worktree add --track -b "$branch" "$workspace_dir" "origin/$branch"

    # Copy .env file if it exists in main workspace
    if [[ -f "$PROJECT_PATH/.env" ]]; then
        echo -e "${YELLOW}Copying .env file...${NC}"
        cp "$PROJECT_PATH/.env" "$workspace_dir/.env"
    fi

    copy_master_key "$workspace_dir"

    # Copy Claude Code settings so permissions carry over
    if [[ -f "$PROJECT_PATH/.claude/settings.local.json" ]]; then
        echo -e "${YELLOW}Copying Claude Code settings...${NC}"
        mkdir -p "$workspace_dir/.claude"
        cp "$PROJECT_PATH/.claude/settings.local.json" "$workspace_dir/.claude/settings.local.json"
    fi

    write_workspace_env "$workspace_dir" "$rails_port" "$vite_port" "$session_cookie" "$redis_db"

    # Register the hostname with Caddy (warning only if Caddy isn't around)
    register_caddy_hostname "$project" "$host_key" "$rails_port"

    # Create a workspace-specific Procfile
    echo -e "${YELLOW}Creating Procfile.workspace...${NC}"
    local procfile="$PROJECT_PATH/Procfile.workspace"
    local template_file="$PROJECT_PATH/Procfile.workspace.template"

    if [[ -f "$procfile" ]]; then
        cp "$procfile" "$workspace_dir/Procfile.workspace"
    elif [[ -f "$template_file" ]]; then
        cp "$template_file" "$workspace_dir/Procfile.workspace"
    else
        # Default Rails Procfile — reads ports from .env
        cat > "$workspace_dir/Procfile.workspace" << 'EOF'
web: RUBY_DEBUG_OPEN=true bin/rails server -p $RAILS_PORT
vite: bin/vite dev
worker: RUBY_DEBUG_OPEN=true bundle exec sidekiq -C config/sidekiq.yml
EOF
    fi

    preseed_claude_trust "$workspace_dir"

    # Create tmux session (keyed off the directory, not the branch)
    local tmux_session="${project}-$(basename "$workspace_dir")"
    echo -e "${YELLOW}Creating tmux session: $tmux_session${NC}"

    # Create feature scratchpad under tmp/
    local notes_file
    notes_file=$(scratchpad_path "$workspace_dir" "$branch")
    mkdir -p "$(dirname "$notes_file")"

    # Try to fetch PR description from GitHub
    echo -e "${YELLOW}Fetching PR description from GitHub...${NC}"
    local pr_description=""
    local pr_title=""
    local pr_url=""

    # Get PR info for this branch (using gh CLI)
    if command -v gh &> /dev/null; then
        pr_url=$(gh pr view "$branch" --repo "$(git -C "$PROJECT_PATH" remote get-url origin)" --json url --jq '.url' 2>/dev/null || true)
        pr_title=$(gh pr view "$branch" --repo "$(git -C "$PROJECT_PATH" remote get-url origin)" --json title --jq '.title' 2>/dev/null || true)
        pr_description=$(gh pr view "$branch" --repo "$(git -C "$PROJECT_PATH" remote get-url origin)" --json body --jq '.body' 2>/dev/null || true)
    fi

    if [[ ! -f "$notes_file" ]]; then
        if [[ -n "$pr_title" ]]; then
            echo -e "  Found PR: ${CYAN}$pr_title${NC}"
            cat > "$notes_file" << EOF
# $pr_title

---
Server URL:  $server_url
Hostname:    $host_url
Git branch:  $branch
Path:        $workspace_dir
PR:          $pr_url
---

$(scratchpad_notice)

## PR Description

$pr_description
EOF
        else
            echo -e "  ${YELLOW}No PR found for branch, creating basic notes file${NC}"
            cat > "$notes_file" << EOF
# $branch

---
Server URL:  $server_url
Hostname:    $host_url
Git branch:  $branch
Path:        $workspace_dir
---

$(scratchpad_notice)

No PR found for this branch.
EOF
        fi
    elif [[ -n "$pr_title" ]]; then
        echo -e "  Found PR: ${CYAN}$pr_title${NC} (scratchpad already exists, leaving it alone)"
    fi

    # Create tmux session with first window for coding
    tmux new-session -d -s "$tmux_session" -c "$workspace_dir" -n "code"

    # Split first window vertically: vim on left, shell on right
    tmux send-keys -t "$tmux_session:code" "vim \"$notes_file\"" C-m
    tmux split-window -h -t "$tmux_session:code" -c "$workspace_dir"

    # Display banner in shell pane
    show_banner "$tmux_session:code.1" "$workspace_dir" "$project" "Branch:  $branch" "$server_url" "$host_url"

    # Create second window for server
    tmux new-window -t "$tmux_session" -c "$workspace_dir" -n "server"

    # Create a setup script that runs in the server window
    cat > "$workspace_dir/.workspace-setup.sh" << 'SETUP_SCRIPT'
#!/usr/bin/env bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Setting up node version...${NC}"
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use

echo -e "${YELLOW}Installing dependencies...${NC}"
echo -e "  Running bundle install..."
if ! bundle install; then
    echo -e "${RED}bundle install failed${NC}"
    exit 1
fi

echo -e "  Running yarn install..."
if ! yarn install; then
    echo -e "${RED}yarn install failed${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}Setup complete!${NC}"
echo ""
SETUP_SCRIPT

    # Append cleanup to the setup script
    cat >> "$workspace_dir/.workspace-setup.sh" << 'EOF'
rm -f "$0"  # Clean up this script
EOF

    chmod +x "$workspace_dir/.workspace-setup.sh"

    # Run setup then start overmind. The setup script self-deletes, so on
    # subsequent up-arrow replays the test -x silently skips it.
    tmux send-keys -t "$tmux_session:server" "test -x ./.workspace-setup.sh && ./.workspace-setup.sh; overmind start -f Procfile.workspace" C-m

    # Go back to first window, focus on vim pane
    tmux select-window -t "$tmux_session:code"
    tmux select-pane -t "$tmux_session:code.0"

    echo ""
    echo -e "${GREEN}Workspace created from remote branch!${NC}"
    echo ""
    echo -e "  Tmux session: ${YELLOW}$tmux_session${NC}"
    echo -e "  Server URL:   ${YELLOW}$server_url${NC}"
    echo -e "  Hostname:     ${YELLOW}$host_url${NC}"
    echo -e "  Claude trust: $CLAUDE_TRUST_SUMMARY"
    echo ""
    echo -e "Switch to session:"
    echo -e "  ${YELLOW}tmux switch-client -t $tmux_session${NC}"
    echo ""
    echo -e "Or if not in tmux:"
    echo -e "  ${YELLOW}tmux attach -t $tmux_session${NC}"
    echo ""
    echo -e "To delete this workspace later:"
    echo -e "  ${YELLOW}workspace delete $project $branch${NC}"
}

# ============================================================================
# Subcommand: resume
# ============================================================================

cmd_resume() {
    if [[ "$1" == "--all" ]]; then
        cmd_resume_all
        return
    fi

    local project="$1"
    local feature="${2:-}"

    if [[ -z "$project" ]]; then
        echo "Usage: workspace resume <project> [feature]"
        echo "       workspace resume --all"
        echo ""
        echo "Examples:"
        echo "  workspace resume tract my-feature   # resume one workspace"
        echo "  workspace resume tract              # resume all tract workspaces"
        echo "  workspace resume --all              # resume all workspaces"
        exit 1
    fi

    validate_project "$project"
    get_project_paths "$project"

    # Project-level resume: resume all stopped workspaces for this project
    if [[ -z "$feature" ]]; then
        local worktrees
        worktrees=$(git -C "$PROJECT_PATH" worktree list 2>/dev/null || true)
        [[ -z "$worktrees" ]] && { echo "No worktrees found for $project."; return; }

        local workspace_worktrees
        workspace_worktrees=$(echo "$worktrees" | grep -v "^$PROJECT_PATH " || true)

        local to_resume=()
        local already_running=()

        # Check main workspace
        if [[ -f "$PROJECT_PATH/Procfile.workspace" ]]; then
            local main_session="${project}-main"
            if tmux has-session -t "$main_session" 2>/dev/null; then
                already_running+=("main")
            else
                to_resume+=("main")
            fi
        fi

        # Check feature worktrees
        if [[ -n "$workspace_worktrees" ]]; then
            while IFS= read -r line; do
                local path wt_feature
                path=$(echo "$line" | awk '{print $1}')
                wt_feature=$(basename "$path")

                local tmux_session="${project}-${wt_feature}"
                if tmux has-session -t "$tmux_session" 2>/dev/null; then
                    already_running+=("$wt_feature")
                else
                    to_resume+=("$wt_feature")
                fi
            done <<< "$workspace_worktrees"
        fi

        if [[ ${#to_resume[@]} -eq 0 && ${#already_running[@]} -eq 0 ]]; then
            echo "No workspaces found for $project."
            return
        fi

        if [[ ${#already_running[@]} -gt 0 ]]; then
            echo -e "${BLUE}Already running:${NC}"
            for item in "${already_running[@]}"; do
                echo -e "  $item"
            done
            echo ""
        fi

        if [[ ${#to_resume[@]} -eq 0 ]]; then
            echo "All $project workspaces are already running."
            return
        fi

        echo -e "${GREEN}Resuming ${#to_resume[@]} $project workspace(s)...${NC}"
        echo ""

        local resumed=0
        for wt_feature in "${to_resume[@]}"; do
            echo -e "${CYAN}━━━ $project / $wt_feature ━━━${NC}"
            cmd_resume "$project" "$wt_feature"
            resumed=$((resumed + 1))
            echo ""
        done

        echo -e "${GREEN}Done! Resumed $resumed workspace(s).${NC}"
        return
    fi

    local workspace_dir

    if is_main_workspace "$feature"; then
        workspace_dir="$PROJECT_PATH"

        # Check if main workspace has been initialized
        if [[ ! -f "$workspace_dir/Procfile.workspace" ]]; then
            echo -e "${RED}Error: Main workspace not initialized${NC}"
            echo -e "Use ${YELLOW}workspace new $project main${NC} to initialize it."
            exit 1
        fi
    else
        workspace_dir=$(resolve_worktree_path "$project" "$feature")
    fi

    # If no worktree exists, check if the branch exists and create worktree from it
    if [[ -z "$workspace_dir" ]]; then
        # Check if the branch exists locally
        if ! git -C "$PROJECT_PATH" rev-parse --verify "$feature" &>/dev/null; then
            echo -e "${RED}Error: No worktree or branch found for '$feature'${NC}"
            echo ""
            echo "Use 'workspace new' or 'workspace pull' to create a workspace first."
            exit 1
        fi

        workspace_dir="$WORKTREE_DIR/$(sanitize_dir_name "$feature")"

        echo -e "${GREEN}Creating workspace from existing branch: $feature${NC}"

        # Generate ports and settings
        local rails_port
        rails_port=$(next_free_port)
        local vite_port=$((rails_port + 2))
        local server_url="http://localhost:$rails_port"
        local session_cookie="${project}_cookie_${rails_port}"
        local redis_db=""
        if [[ "$USES_REDIS" == "true" ]]; then
            redis_db=$(next_free_redis_db)
        fi

        echo -e "  Project:             $project"
        echo -e "  Workspace directory: $workspace_dir"
        echo -e "  Rails port:          $rails_port"
        echo -e "  Hostname:            http://$(workspace_hostname "$project" "$(basename "$workspace_dir")")"
        echo -e "  Vite port:           $vite_port"
        echo -e "  Session cookie:      $session_cookie"
        [[ -n "$redis_db" ]] && echo -e "  Redis DB:            $redis_db"
        echo ""

        # Create worktree from existing branch
        echo -e "${YELLOW}Creating git worktree...${NC}"
        git -C "$PROJECT_PATH" worktree add "$workspace_dir" "$feature"

        # Copy .env file if it exists in main workspace
        if [[ -f "$PROJECT_PATH/.env" ]]; then
            echo -e "${YELLOW}Copying .env file...${NC}"
            cp "$PROJECT_PATH/.env" "$workspace_dir/.env"
        fi

        copy_master_key "$workspace_dir"

        # Copy Claude Code settings so permissions carry over
        if [[ -f "$PROJECT_PATH/.claude/settings.local.json" ]]; then
            echo -e "${YELLOW}Copying Claude Code settings...${NC}"
            mkdir -p "$workspace_dir/.claude"
            cp "$PROJECT_PATH/.claude/settings.local.json" "$workspace_dir/.claude/settings.local.json"
        fi

        write_workspace_env "$workspace_dir" "$rails_port" "$vite_port" "$session_cookie" "$redis_db"

        # Create Procfile.workspace
        echo -e "${YELLOW}Creating Procfile.workspace...${NC}"
        local procfile="$PROJECT_PATH/Procfile.workspace"
        local template_file="$PROJECT_PATH/Procfile.workspace.template"
        if [[ -f "$procfile" ]]; then
            cp "$procfile" "$workspace_dir/Procfile.workspace"
        elif [[ -f "$template_file" ]]; then
            cp "$template_file" "$workspace_dir/Procfile.workspace"
        else
            cat > "$workspace_dir/Procfile.workspace" << 'EOF'
web: RUBY_DEBUG_OPEN=true bin/rails server -p $RAILS_PORT
vite: bin/vite dev
worker: RUBY_DEBUG_OPEN=true bundle exec sidekiq -C config/sidekiq.yml
EOF
        fi

        # Create feature scratchpad under tmp/
        local notes_file
        notes_file=$(scratchpad_path "$workspace_dir" "$feature")
        mkdir -p "$(dirname "$notes_file")"
        if [[ ! -f "$notes_file" ]]; then
            cat > "$notes_file" << EOF
# $feature

---
Server URL:  $server_url
Git branch:  $feature
Path:        $workspace_dir
---

$(scratchpad_notice)
EOF
        fi

        preseed_claude_trust "$workspace_dir"

        # Fall through to tmux session creation below
    fi

    # Check if workspace exists on disk
    if [[ ! -d "$workspace_dir" ]]; then
        echo -e "${RED}Error: Workspace directory does not exist: $workspace_dir${NC}"
        exit 1
    fi

    # Derive tmux session name from the workspace directory, not the git branch.
    # The directory name is stable; the branch checked out inside it can change,
    # which would otherwise orphan the session from every lookup that rebuilds
    # the name from the current branch.
    local session_name
    if is_main_workspace "$feature"; then
        session_name="main"
    else
        session_name=$(basename "$workspace_dir")
    fi
    local tmux_session="${project}-${session_name}"

    # Check if tmux session already exists
    if tmux has-session -t "$tmux_session" 2>/dev/null; then
        echo -e "${YELLOW}Tmux session '$tmux_session' already exists${NC}"
        echo ""
        echo -e "Switch to session:"
        echo -e "  ${YELLOW}tmux switch-client -t $tmux_session${NC}"
        echo ""
        echo -e "Or if not in tmux:"
        echo -e "  ${YELLOW}tmux attach -t $tmux_session${NC}"
        exit 0
    fi

    # Read port from existing .env if available (may already be set from branch-creation path)
    if [[ -z "${server_url:-}" ]]; then
        local rails_port=""
        local server_url=""
        if [[ -f "$workspace_dir/.env" ]]; then
            rails_port=$(grep '^RAILS_PORT=' "$workspace_dir/.env" | cut -d= -f2 | tr -d '"' || true)
            # Fall back to deriving from VITE_RUBY_PORT for legacy workspaces
            if [[ -z "$rails_port" ]]; then
                local vite_port
                vite_port=$(grep '^VITE_RUBY_PORT=' "$workspace_dir/.env" | cut -d= -f2 | tr -d '"' || true)
                if [[ -n "$vite_port" ]]; then
                    rails_port=$((vite_port - 2))
                fi
            fi
            if [[ -n "$rails_port" ]]; then
                server_url="http://localhost:$rails_port"
            fi
        fi
    fi

    # Make sure the hostname is registered with Caddy. Usually a no-op; it
    # backfills workspaces created before hostnames existed and repairs a
    # snippet that went missing.
    local host_key="main"
    if ! is_main_workspace "$feature"; then
        host_key=$(basename "$workspace_dir")
    fi
    local host_url=""
    if [[ -n "${rails_port:-}" ]]; then
        host_url="http://$(workspace_hostname "$project" "$host_key")"
        register_caddy_hostname "$project" "$host_key" "$rails_port"
    fi

    echo -e "${GREEN}Resuming workspace: $feature${NC}"
    echo -e "  Project:             $project"
    echo -e "  Workspace directory: $workspace_dir"
    if [[ -n "$server_url" ]]; then
        echo -e "  Server URL:          $server_url"
    fi
    if [[ -n "$host_url" ]]; then
        echo -e "  Hostname:            $host_url"
    fi
    echo ""

    # Create tmux session
    echo -e "${YELLOW}Creating tmux session: $tmux_session${NC}"

    # Create tmux session with first window for coding
    tmux new-session -d -s "$tmux_session" -c "$workspace_dir" -n "code"

    # Open the feature scratchpad if it exists (tmp/, or legacy docs/local, docs/)
    local docs_file=""
    if ! is_main_workspace "$feature"; then
        docs_file=$(resolve_scratchpad "$workspace_dir" "$feature")
        [[ -f "$docs_file" ]] || docs_file=""
    fi

    if [[ -n "$docs_file" ]]; then
        tmux send-keys -t "$tmux_session:code" "vim \"$docs_file\"" C-m
    else
        tmux send-keys -t "$tmux_session:code" "vim" C-m
    fi

    # Split first window vertically: vim on left, shell on right
    tmux split-window -h -t "$tmux_session:code" -c "$workspace_dir"

    # Display banner in shell pane
    if is_main_workspace "$feature"; then
        show_banner "$tmux_session:code.1" "$workspace_dir" "$project" "Branch:  main" "${server_url:-"(unknown)"}" "$host_url"
    else
        show_banner "$tmux_session:code.1" "$workspace_dir" "$project" "Feature: $feature" "${server_url:-"(unknown)"}" "$host_url"
    fi

    # Create second window for server
    tmux new-window -t "$tmux_session" -c "$workspace_dir" -n "server"

    # Create a setup script that runs in the server window
    cat > "$workspace_dir/.workspace-setup.sh" << 'SETUP_SCRIPT'
#!/usr/bin/env bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Setting up node version...${NC}"
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use

echo -e "${YELLOW}Installing dependencies...${NC}"
echo -e "  Running bundle install..."
if ! bundle install; then
    echo -e "${RED}bundle install failed${NC}"
    exit 1
fi

echo -e "  Running yarn install..."
if ! yarn install; then
    echo -e "${RED}yarn install failed${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}Setup complete!${NC}"
echo ""
SETUP_SCRIPT

    # Append cleanup to the setup script
    cat >> "$workspace_dir/.workspace-setup.sh" << 'EOF'
rm -f "$0"  # Clean up this script
EOF

    chmod +x "$workspace_dir/.workspace-setup.sh"

    # Run setup then start overmind. The setup script self-deletes, so on
    # subsequent up-arrow replays the test -x silently skips it.
    tmux send-keys -t "$tmux_session:server" "test -x ./.workspace-setup.sh && ./.workspace-setup.sh; overmind start -f Procfile.workspace" C-m

    # Go back to first window, focus on vim pane
    tmux select-window -t "$tmux_session:code"
    tmux select-pane -t "$tmux_session:code.0"

    echo ""
    echo -e "${GREEN}Workspace resumed!${NC}"
    echo ""
    echo -e "  Tmux session: ${YELLOW}$tmux_session${NC}"
    if [[ -n "$server_url" ]]; then
        echo -e "  Server URL:   ${YELLOW}$server_url${NC}"
    fi
    if [[ -n "$host_url" ]]; then
        echo -e "  Hostname:     ${YELLOW}$host_url${NC}"
    fi
    echo ""
    echo -e "Switch to session:"
    echo -e "  ${YELLOW}tmux switch-client -t $tmux_session${NC}"
    echo ""
    echo -e "Or if not in tmux:"
    echo -e "  ${YELLOW}tmux attach -t $tmux_session${NC}"
}

# ============================================================================
# Subcommand: stop
# ============================================================================

stop_one_workspace() {
    local project="$1"
    local workspace_dir="$2"
    local session_name="$3"

    local tmux_session="${project}-${session_name}"
    local stopped=false

    if [[ -S "$workspace_dir/.overmind.sock" ]]; then
        echo -e "${YELLOW}Stopping overmind in $workspace_dir...${NC}"
        (cd "$workspace_dir" && overmind quit 2>/dev/null) || true
        # Wait for overmind to release the socket
        local tries=0
        while [[ -S "$workspace_dir/.overmind.sock" ]] && (( tries < 10 )); do
            sleep 0.3
            ((tries++))
        done
        rm -f "$workspace_dir/.overmind.sock"
        stopped=true
    fi

    if tmux has-session -t "$tmux_session" 2>/dev/null; then
        echo -e "${YELLOW}Killing tmux session: $tmux_session${NC}"
        tmux kill-session -t "$tmux_session"
        stopped=true
    fi

    if [[ "$stopped" == false ]]; then
        echo -e "  ${BLUE}$session_name${NC} — already stopped"
    else
        echo -e "  ${GREEN}$session_name${NC} — stopped"
    fi
}

cmd_stop() {
    local project="$1"
    local feature="${2:-}"

    if [[ -z "$project" ]]; then
        echo "Usage: workspace stop <project> [feature]"
        echo ""
        echo "Examples:"
        echo "  workspace stop tract my-feature   # stop one workspace"
        echo "  workspace stop tract              # stop all tract workspaces"
        exit 1
    fi

    validate_project "$project"
    get_project_paths "$project"

    if [[ -n "$feature" ]]; then
        # Stop a single workspace
        if is_main_workspace "$feature"; then
            stop_one_workspace "$project" "$PROJECT_PATH" "main"
        else
            local workspace_dir
            workspace_dir=$(resolve_worktree_path "$project" "$feature")
            if [[ -z "$workspace_dir" ]]; then
                echo -e "${RED}Error: No worktree found for '$feature'${NC}"
                exit 1
            fi

            stop_one_workspace "$project" "$workspace_dir" "$(basename "$workspace_dir")"
        fi
    else
        # Stop all workspaces for this project
        echo -e "${GREEN}Stopping all $project workspaces...${NC}"
        echo ""

        # Stop main workspace if initialized
        if [[ -f "$PROJECT_PATH/Procfile.workspace" ]]; then
            stop_one_workspace "$project" "$PROJECT_PATH" "main"
        fi

        # Stop feature worktrees
        local worktrees
        worktrees=$(git -C "$PROJECT_PATH" worktree list 2>/dev/null || true)

        if [[ -n "$worktrees" ]]; then
            local workspace_worktrees
            workspace_worktrees=$(echo "$worktrees" | grep -v "^$PROJECT_PATH " || true)

            if [[ -n "$workspace_worktrees" ]]; then
                while IFS= read -r line; do
                    local path
                    path=$(echo "$line" | awk '{print $1}')

                    stop_one_workspace "$project" "$path" "$(basename "$path")"
                done <<< "$workspace_worktrees"
            fi
        fi
    fi

    echo ""
    echo -e "${GREEN}Done.${NC}"
}

# ============================================================================
# Claude session consolidation
# ============================================================================

# Move Claude Code conversation files from a worktree's project dir into the
# main repo's project dir so they appear in `claude resume` from the main repo.
consolidate_claude_sessions() {
    local worktree_path="$1"
    local main_repo_path="$2"

    # Encode paths the way Claude Code does: replace / with - and prepend -
    local worktree_encoded="${worktree_path//\//-}"
    local main_encoded="${main_repo_path//\//-}"

    local src="$HOME/.claude/projects/$worktree_encoded"
    local dst="$HOME/.claude/projects/$main_encoded"

    if [[ ! -d "$src" ]]; then
        return
    fi

    mkdir -p "$dst"

    local moved=0
    for jsonl in "$src"/*.jsonl; do
        [[ -f "$jsonl" ]] || continue
        local uuid
        uuid=$(basename "$jsonl" .jsonl)
        mv "$jsonl" "$dst/"
        [[ -d "$src/$uuid" ]] && mv "$src/$uuid" "$dst/"
        moved=$((moved + 1))
    done

    # Clean up the now-empty project dir (memory/ and anything else)
    rm -rf "$src"

    if [[ $moved -gt 0 ]]; then
        echo -e "${BLUE}Moved $moved Claude session(s) to main project${NC}"
    fi
}

# ============================================================================
# Subcommand: delete
# ============================================================================

cmd_delete() {
    local project="$1"
    local feature="$2"
    local force=false

    # Check for --force flag
    if [[ "$3" == "--force" ]]; then
        force=true
    fi

    if [[ -z "$project" ]] || [[ -z "$feature" ]]; then
        echo "Usage: workspace delete <project> <feature> [--force]"
        echo ""
        echo "Example: workspace delete tract my-feature"
        exit 1
    fi

    if is_main_workspace "$feature"; then
        echo -e "${RED}Error: Cannot delete the main workspace${NC}"
        exit 1
    fi

    validate_project "$project"
    get_project_paths "$project"

    local workspace_dir
    workspace_dir=$(resolve_worktree_path "$project" "$feature")
    if [[ -z "$workspace_dir" ]]; then
        echo -e "${RED}Error: No worktree found for '$feature'${NC}"
        echo ""
        echo "Current worktrees for $project:"
        git -C "$PROJECT_PATH" worktree list
        exit 1
    fi

    # Capture the actual branch name from the worktree before we remove it
    # (needed for the branch-deletion prompt below). The tmux session, however,
    # is keyed off the directory name, which is stable regardless of branch.
    local worktree_branch
    worktree_branch=$(git -C "$PROJECT_PATH" worktree list | awk -v dir="$workspace_dir " '$0 ~ dir {gsub(/[\[\]]/, "", $3); print $3; exit}')
    local tmux_session="${project}-$(basename "$workspace_dir")"

    # Prevent deleting the main directory
    if [[ "$workspace_dir" == "$PROJECT_PATH" ]]; then
        echo -e "${RED}Error: Cannot delete the main workspace${NC}"
        exit 1
    fi

    echo -e "${YELLOW}Workspace to delete: $feature${NC}"
    echo -e "  Project:   $project"
    echo -e "  Directory: $workspace_dir"
    echo ""

    # Rescue untracked files from docs/local before anything is torn down.
    # docs/local is gitignored, so real files living in it would vanish with the
    # worktree. Symlinks inside docs/local point to shared locations outside the
    # worktree, so their targets survive deletion — nothing to rescue there.
    # `find -type f` (no -L) is exactly the set at risk: it reports symlinks as
    # -type l and won't descend into symlinked directories, so only real files
    # are counted and copied. The feature scratchpad is throwaway by design
    # (older workspaces kept it here before it moved to tmp/), so it's excluded.
    local docs_local="$workspace_dir/docs/local"
    local legacy_scratchpad="./$(sanitize_dir_name "$feature").md"
    if [[ -d "$docs_local" ]]; then
        local risked_count
        risked_count=$(cd "$docs_local" && find . -type f ! -path "$legacy_scratchpad" 2>/dev/null | wc -l | tr -d ' ')
        if [[ "$risked_count" -gt 0 ]]; then
            echo -e "${BLUE}docs/local has $risked_count untracked file(s) that would be lost:${NC}"
            (cd "$docs_local" && find . -type f ! -path "$legacy_scratchpad" 2>/dev/null | sed 's|^\./|  |')
            echo ""

            local rescue_choice
            if [[ "$force" == true ]]; then
                # No human to ask; copying is non-destructive, so always rescue.
                rescue_choice="c"
            else
                read -p "[C]opy to main docs/local and continue / [S]kip and delete anyway / [A]bort? [c/s/A] " -n 1 -r rescue_choice
                echo
            fi

            case "$rescue_choice" in
                [Cc])
                    local rescue_dst="$PROJECT_PATH/docs/local/rescued-$feature"
                    echo -e "${YELLOW}Copying docs/local files to $rescue_dst${NC}"
                    mkdir -p "$rescue_dst"
                    (cd "$docs_local" && find . -type f ! -path "$legacy_scratchpad" -print0 2>/dev/null | while IFS= read -r -d '' f; do
                        mkdir -p "$rescue_dst/$(dirname "$f")"
                        cp -p "$f" "$rescue_dst/$f"
                    done)
                    echo -e "${GREEN}Rescued $risked_count file(s) to $rescue_dst${NC}"
                    ;;
                [Ss])
                    echo -e "${YELLOW}Skipping rescue — docs/local files will be deleted.${NC}"
                    ;;
                *)
                    echo "Aborted. Nothing was deleted."
                    exit 0
                    ;;
            esac
            echo ""
        fi
    fi

    # Confirm deletion BEFORE tearing anything down, so cancelling is a true
    # no-op. Teardown (overmind, then tmux) is deferred until after this point —
    # and the tmux kill is saved for the very end, because deleting the session
    # this command was launched from would kill the script mid-run otherwise.
    if [[ "$force" != true ]]; then
        read -p "Delete worktree at $workspace_dir? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Cancelled."
            exit 0
        fi
    fi

    # Stop overmind before removing the worktree (its socket lives inside it)
    if [[ -S "$workspace_dir/.overmind.sock" ]]; then
        echo -e "${YELLOW}Stopping overmind...${NC}"
        (cd "$workspace_dir" && overmind quit 2>/dev/null) || true
        local tries=0
        while [[ -S "$workspace_dir/.overmind.sock" ]] && (( tries < 10 )); do
            sleep 0.3
            ((tries++))
        done
        rm -f "$workspace_dir/.overmind.sock"
    fi

    # Remove the worktree
    echo -e "${YELLOW}Removing git worktree...${NC}"
    cd "$PROJECT_PATH"
    if ! git worktree remove "$workspace_dir" --force 2>/dev/null; then
        echo -e "${YELLOW}Worktree has untracked files, cleaning up manually...${NC}"
        # Retry: macOS Finder/Spotlight can recreate .DS_Store mid-delete,
        # leaving an otherwise-empty dir and an ENOTEMPTY failure behind.
        # The `&& break` keeps a failing rm from tripping `set -e`.
        for _ in 1 2 3; do
            rm -rf "$workspace_dir" && break
            sleep 0.2
        done
        if [[ -d "$workspace_dir" ]]; then
            echo -e "${RED}Warning: could not fully remove $workspace_dir${NC}"
        fi
        git worktree prune
    fi

    # Move Claude Code sessions from the worktree to the main project
    consolidate_claude_sessions "$workspace_dir" "$PROJECT_PATH"

    # Drop the worktree's folder-trust entry so ~/.claude.json doesn't
    # accumulate dead paths
    remove_claude_trust "$workspace_dir"

    # Drop the hostname route. Never fails — a stopped Caddy is just a warning.
    unregister_caddy_hostname "$project" "$(basename "$workspace_dir")"

    # Ask about deleting the branch
    if [[ -n "$worktree_branch" ]]; then
        local branch_exists
        branch_exists=$(git branch --list "$worktree_branch")
        if [[ -n "$branch_exists" ]]; then
            local delete_branch
            if [[ "$force" == true ]]; then
                delete_branch="y"
            else
                read -p "Delete branch '$worktree_branch'? [y/N] " -n 1 -r delete_branch
                echo
            fi

            if [[ $delete_branch =~ ^[Yy]$ ]]; then
                echo -e "${YELLOW}Deleting branch: $worktree_branch${NC}"
                git branch -D "$worktree_branch"
            else
                echo -e "Branch '$worktree_branch' kept. Delete it later with: git branch -D $worktree_branch"
            fi
        fi
    fi

    echo ""
    echo -e "${GREEN}Workspace deleted successfully!${NC}"

    # Kill the tmux session LAST. If this command was launched from inside that
    # session, this destroys our own pane — so all the real work above must be
    # finished by now. The success message prints first because we may not
    # survive past this point to print anything after it.
    if tmux has-session -t "$tmux_session" 2>/dev/null; then
        echo -e "${YELLOW}Killing tmux session: $tmux_session${NC}"
        tmux kill-session -t "$tmux_session"
    fi
}

# ============================================================================
# Subcommand: info
# ============================================================================

cmd_info() {
    local cwd
    cwd=$(pwd -P)

    local found_project=""
    local found_feature=""
    local found_workspace=""

    for project in $(list_projects); do
        get_project_paths "$project"

        # Check main workspace first
        local real_project_path
        real_project_path=$(cd "$PROJECT_PATH" && pwd -P)

        if [[ "$cwd" == "$real_project_path" || "$cwd" == "$real_project_path/"* ]]; then
            if [[ -f "$PROJECT_PATH/Procfile.workspace" ]]; then
                found_project="$project"
                found_feature="main"
                found_workspace="$PROJECT_PATH"
                break
            fi
        fi

        # Check worktrees
        while IFS= read -r line; do
            local wt_path
            wt_path=$(echo "$line" | awk '{print $1}')
            [[ "$wt_path" == "$real_project_path" ]] && continue

            local real_wt_path
            real_wt_path=$(cd "$wt_path" 2>/dev/null && pwd -P) || continue

            if [[ "$cwd" == "$real_wt_path" || "$cwd" == "$real_wt_path/"* ]]; then
                found_project="$project"
                found_feature=$(basename "$wt_path")
                found_workspace="$wt_path"
                break 2
            fi
        done <<< "$(git -C "$PROJECT_PATH" worktree list 2>/dev/null)"
    done

    if [[ -z "$found_project" ]]; then
        echo -e "${RED}Not inside a workspace directory${NC}"
        exit 1
    fi

    # Read info from .env
    local rails_port="" redis_db="" server_url=""
    if [[ -f "$found_workspace/.env" ]]; then
        rails_port=$(grep '^RAILS_PORT=' "$found_workspace/.env" | cut -d= -f2 | tr -d '"' || true)
        if [[ -z "$rails_port" ]]; then
            local vite_port
            vite_port=$(grep '^VITE_RUBY_PORT=' "$found_workspace/.env" | cut -d= -f2 | tr -d '"' || true)
            if [[ -n "$vite_port" ]]; then
                rails_port=$((vite_port - 2))
            fi
        fi
        if [[ -n "$rails_port" ]]; then
            server_url="http://localhost:$rails_port"
        fi
        redis_db=$(grep '^REDIS_URL=' "$found_workspace/.env" | sed 's|.*redis://[^/]*/||' | tr -d '"' || true)
    fi

    # Check tmux session
    local tmux_session="${found_project}-${found_feature}"
    local tmux_status="stopped"
    if tmux has-session -t "$tmux_session" 2>/dev/null; then
        tmux_status="running"
    fi

    # Check git branch
    local git_branch
    git_branch=$(git -C "$found_workspace" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

    echo ""
    echo -e "  ${BLUE}Project${NC}  $found_project"
    echo -e "  ${BLUE}Feature${NC}  $found_feature"
    echo -e "  ${BLUE}Branch${NC}   $git_branch"
    echo -e "  ${BLUE}Path${NC}     $found_workspace"
    if [[ -n "$server_url" ]]; then
        echo -e "  ${BLUE}Server${NC}   ${YELLOW}$server_url${NC}"
        echo -e "  ${BLUE}Host${NC}     ${YELLOW}http://$(workspace_hostname "$found_project" "$found_feature")${NC}"
    fi
    if [[ -n "$rails_port" ]]; then
        echo -e "  ${BLUE}Port${NC}     $rails_port"
    fi
    if [[ -n "$redis_db" ]]; then
        echo -e "  ${BLUE}Redis${NC}    db $redis_db"
    fi
    echo -e "  ${BLUE}Tmux${NC}     $tmux_session ($tmux_status)"
    echo ""
}

# ============================================================================
# Subcommand: list
# ============================================================================

# Emit a normalized agent-status token for a tmux session, or "~" (blank) when
# there is nothing to report. The status glyph lives in the session's
# @agent_status user option, set by the Claude Code hooks that `workspace
# install-hooks` installs. The same option feeds the tmux session chooser.
agent_status_token() {
    local tmux_session="$1"

    tmux has-session -t "$tmux_session" 2>/dev/null || { echo "~"; return; }

    case "$(tmux show-options -t "$tmux_session" -v @agent_status 2>/dev/null)" in
        ●) echo "working" ;;
        ▲) echo "needs-you" ;;
        ◇) echo "waiting" ;;
        ○) echo "idle" ;;
        *) echo "~" ;;
    esac
}

# Best-effort "last worked on" timestamp for a workspace directory, as epoch
# seconds (0 = no signal). Takes the newer of:
#   - the newest Claude Code session file for this path (every Claude turn
#     appends to its .jsonl, so mtime tracks conversation activity)
#   - the last reflog entry in the worktree (commit/checkout/pull/reset)
# Worktree file mtimes and the git index are deliberately NOT used: bulk
# operations (yarn install, background git status sweeps) touch them without
# any real work happening.
last_active_ts() {
    local workspace_dir="$1"
    local newest=0 ts

    # Claude Code encodes project dirs by replacing / with -
    # (same encoding as consolidate_claude_sessions)
    local claude_dir="$HOME/.claude/projects/${workspace_dir//\//-}"
    local newest_jsonl
    newest_jsonl=$(ls -t "$claude_dir"/*.jsonl 2>/dev/null | head -1)
    if [[ -n "$newest_jsonl" ]]; then
        ts=$(stat -f %m "$newest_jsonl" 2>/dev/null || true)
        if [[ -n "$ts" && "$ts" -gt "$newest" ]]; then
            newest=$ts
        fi
    fi

    ts=$(git -C "$workspace_dir" log -g -1 --format=%ct HEAD 2>/dev/null || true)
    if [[ -n "$ts" && "$ts" -gt "$newest" ]]; then
        newest=$ts
    fi

    echo "$newest"
}

# Render an epoch timestamp as a compact relative time ("5m ago", "3h ago",
# "4d ago", then "Jun 12"). 0 renders as the table blank placeholder.
format_last_active() {
    local ts="$1"
    if [[ -z "$ts" || "$ts" -eq 0 ]]; then
        echo "~"
        return
    fi

    local diff=$(( $(date +%s) - ts ))
    if (( diff < 3600 )); then
        echo "$(( diff / 60 ))m ago"
    elif (( diff < 86400 )); then
        echo "$(( diff / 3600 ))h ago"
    elif (( diff < 604800 )); then
        echo "$(( diff / 86400 ))d ago"
    else
        date -r "$ts" '+%b %d'
    fi
}

# Hostname for a `list`/`ports` row, or "~" (blank) when the workspace has no
# port recorded — nothing for Caddy to route to in that case.
list_hostname() {
    local project="$1"
    local key="$2"
    local dir="$3"
    if [[ -n "$(workspace_rails_port "$dir")" ]]; then
        workspace_hostname "$project" "$key"
    else
        echo "~"
    fi
}

cmd_list() {
    local filter_project=""
    local show_pr=false
    local running_only=false
    local sort_recent=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pr) show_pr=true; shift ;;
            --running) running_only=true; shift ;;
            --recent) sort_recent=true; shift ;;
            *) filter_project="$1"; shift ;;
        esac
    done

    if [[ -n "$filter_project" ]]; then
        validate_project "$filter_project"
    fi

    local projects
    if [[ -n "$filter_project" ]]; then
        projects="$filter_project"
    else
        projects=$(list_projects)
    fi

    # Rows carry a "project_idx,epoch," sort-key prefix that is stripped after
    # sorting, before rendering.
    local rows=""
    local project_idx=0

    for project in $projects; do
        project_idx=$((project_idx + 1))
        get_project_paths "$project"

        # Get worktrees for this project
        local worktrees
        worktrees=$(git -C "$PROJECT_PATH" worktree list 2>/dev/null || true)

        if [[ -z "$worktrees" ]]; then
            continue
        fi

        # Filter out the main project path, only show actual worktrees
        local workspace_worktrees
        workspace_worktrees=$(echo "$worktrees" | grep -v "^$PROJECT_PATH " || true)

        local origin_url=""
        if [[ "$show_pr" == true ]] && command -v gh &>/dev/null; then
            origin_url=$(git -C "$PROJECT_PATH" remote get-url origin 2>/dev/null || true)
        fi

        # Check main workspace
        if [[ -f "$PROJECT_PATH/Procfile.workspace" ]]; then
            local main_branch
            main_branch=$(git -C "$PROJECT_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
            local main_tmux="${project}-main"
            local main_tmux_status=""
            if tmux has-session -t "$main_tmux" 2>/dev/null; then
                main_tmux_status="running"
            fi
            local main_tmux_display="${main_tmux_status:-~}"
            local main_status main_ts main_last main_host
            main_status=$(agent_status_token "$main_tmux")
            main_ts=$(last_active_ts "$PROJECT_PATH")
            main_last=$(format_last_active "$main_ts")
            main_host=$(list_hostname "$project" "main" "$PROJECT_PATH")
            if [[ "$running_only" == true && -z "$main_tmux_status" ]]; then
                : # skip non-running workspace
            elif [[ "$show_pr" == true ]]; then
                rows+="$project_idx,$main_ts,$project,main,$main_branch,$main_host,$main_tmux_display,~,$main_last,$main_status"$'\n'
            else
                rows+="$project_idx,$main_ts,$project,main,$main_branch,$main_host,$main_tmux_display,$main_last,$main_status"$'\n'
            fi
        fi

        [[ -z "$workspace_worktrees" ]] && continue

        while IFS= read -r line; do
            local path branch
            path=$(echo "$line" | awk '{print $1}')
            branch=$(echo "$line" | awk '{print $3}' | tr -d '[]')

            # Extract feature name from path
            local feature
            feature=$(basename "$path")

            # Check if tmux session exists (keyed off the directory, not the branch)
            local tmux_session="${project}-${feature}"
            local tmux_status=""
            if tmux has-session -t "$tmux_session" 2>/dev/null; then
                tmux_status="running"
            fi

            # Check PR status via GitHub CLI
            local pr_status=""
            if [[ -n "$origin_url" ]]; then
                local pr_state pr_url
                pr_state=$(gh pr view "$branch" --repo "$origin_url" --json state --jq '.state' 2>/dev/null || true)
                pr_url=$(gh pr view "$branch" --repo "$origin_url" --json url --jq '.url' 2>/dev/null || true)
                case "$pr_state" in
                    OPEN)   pr_status="open" ;;
                    MERGED) pr_status="merged" ;;
                    CLOSED) pr_status="closed" ;;
                esac

                # Add PR URL to scratchpad if missing
                local docs_file
                docs_file=$(resolve_scratchpad "$path" "$feature")
                if [[ -n "$pr_url" && -f "$docs_file" ]] && ! grep -q "^PR:" "$docs_file"; then
                    sed -i '' "/^Path:/s|$|\nPR:          $pr_url|" "$docs_file"
                fi
            fi

            # Pad tmux/pr values so column alignment uses consistent width
            local tmux_display="${tmux_status:-~}"
            local status_token wt_ts wt_last wt_host
            status_token=$(agent_status_token "$tmux_session")
            wt_ts=$(last_active_ts "$path")
            wt_last=$(format_last_active "$wt_ts")
            wt_host=$(list_hostname "$project" "$feature" "$path")
            if [[ "$running_only" == true && -z "$tmux_status" ]]; then
                continue
            elif [[ "$show_pr" == true ]]; then
                local pr_display="${pr_status:-~}"
                rows+="$project_idx,$wt_ts,$project,$feature,$branch,$wt_host,$tmux_display,$pr_display,$wt_last,$status_token"$'\n'
            else
                rows+="$project_idx,$wt_ts,$project,$feature,$branch,$wt_host,$tmux_display,$wt_last,$status_token"$'\n'
            fi
        done <<< "$workspace_worktrees"
    done

    if [[ -z "$rows" ]]; then
        if [[ -n "$filter_project" ]]; then
            echo "No workspaces found for project: $filter_project"
        else
            echo "No workspaces found."
        fi
        return
    fi

    # Sort by config project order, then most-recent-first within each project.
    # --recent drops the grouping: one most-recent-first list across projects.
    if [[ "$sort_recent" == true ]]; then
        rows=$(printf '%s' "$rows" | sort -t, -k2,2nr)
    else
        rows=$(printf '%s' "$rows" | sort -t, -k1,1n -k2,2nr)
    fi
    rows=$(echo "$rows" | cut -d, -f3-)

    local table header_line separator max_width
    local header="Project,Workspace,Branch,Host,Tmux"
    if [[ "$show_pr" == true ]]; then
        header="$header,PR"
    fi
    header="$header,Last active,Status"
    # Trailing newline matters: macOS column errors on unterminated last lines
    table=$(printf "%s\n%s\n" "$header" "$rows" | column -t -s,)
    header_line=$(echo "$table" | head -1)
    max_width=$(echo "$table" | awk '{ if (length > max) max = length } END { print max }')
    separator=$(printf '%*s' "$max_width" '' | tr ' ' '-')

    # Replace placeholders and render table
    local body
    body=$(echo "$table" | tail -n +2 | sed 's/~/ /g')
    # Expand the Status token (always the last column) into a glyph + label.
    # Anchored to end-of-line so it can never collide with a branch/feature name.
    body=$(echo "$body" \
        | sed -E 's/needs-you[[:space:]]*$/▲ needs you/' \
        | sed -E 's/working[[:space:]]*$/● working/' \
        | sed -E 's/waiting[[:space:]]*$/◇ waiting/' \
        | sed -E 's/idle[[:space:]]*$/○ idle/')
    table=$(printf "%s\n%s\n%s" "$header_line" "$separator" "$body")
    echo "$table" | gum style \
        --border rounded \
        --border-foreground "#7D56F4" \
        --padding "0 1"
}

cmd_ports() {
    local running_only=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --running) running_only=true; shift ;;
            *) shift ;;
        esac
    done

    local projects
    projects=$(list_projects)

    local rows=""

    for project in $projects; do
        get_project_paths "$project"

        local worktrees
        worktrees=$(git -C "$PROJECT_PATH" worktree list 2>/dev/null || true)
        [[ -z "$worktrees" ]] && continue

        # Check main workspace
        if [[ -f "$PROJECT_PATH/Procfile.workspace" && -f "$PROJECT_PATH/.env" ]] && \
           { [[ "$running_only" != true ]] || tmux has-session -t "${project}-main" 2>/dev/null; }; then
            local main_rails main_vite main_db
            main_rails=$(grep '^RAILS_PORT=' "$PROJECT_PATH/.env" | cut -d= -f2 | tr -d '"' || true)
            main_vite=$(grep '^VITE_RUBY_PORT=' "$PROJECT_PATH/.env" | cut -d= -f2 | tr -d '"' || true)
            main_db=$(grep '^REDIS_URL=' "$PROJECT_PATH/.env" | sed 's|.*redis://[^/]*/||' | tr -d '"' || true)
            if [[ -z "$main_rails" && -n "$main_vite" ]]; then
                main_rails=$((main_vite - 2))
            fi
            if [[ -n "$main_rails" || -n "$main_vite" || -n "$main_db" ]]; then
                rows+="$project,main,$main_rails,$main_vite,$main_db,$(list_hostname "$project" main "$PROJECT_PATH")"$'\n'
            fi
        fi

        # Feature worktrees
        local workspace_worktrees
        workspace_worktrees=$(echo "$worktrees" | grep -v "^$PROJECT_PATH " || true)
        [[ -z "$workspace_worktrees" ]] && continue

        while IFS= read -r line; do
            local path feature
            path=$(echo "$line" | awk '{print $1}')
            [[ -f "$path/.env" ]] || continue
            feature=$(basename "$path")

            if [[ "$running_only" == true ]] && ! tmux has-session -t "${project}-${feature}" 2>/dev/null; then
                continue
            fi

            local rails_port vite_port db
            rails_port=$(grep '^RAILS_PORT=' "$path/.env" | cut -d= -f2 | tr -d '"' || true)
            vite_port=$(grep '^VITE_RUBY_PORT=' "$path/.env" | cut -d= -f2 | tr -d '"' || true)
            db=$(grep '^REDIS_URL=' "$path/.env" | sed 's|.*redis://[^/]*/||' | tr -d '"' || true)
            # Legacy fallback: derive rails port from vite port
            if [[ -z "$rails_port" && -n "$vite_port" ]]; then
                rails_port=$((vite_port - 2))
            fi

            [[ -z "$rails_port" && -z "$vite_port" && -z "$db" ]] && continue

            rows+="$project,$feature,$rails_port,$vite_port,$db,$(list_hostname "$project" "$feature" "$path")"$'\n'
        done <<< "$workspace_worktrees"
    done

    if [[ -z "$rows" ]]; then
        if [[ "$running_only" == true ]]; then
            echo "No running workspaces found."
        else
            echo "No workspaces found."
        fi
        return
    fi

    local table header_line separator max_width
    table=$(printf "Project,Workspace,Rails,Vite,Redis,Host\n%s" "$rows" | column -t -s,)
    header_line=$(echo "$table" | head -1)
    max_width=$(echo "$table" | awk '{ if (length > max) max = length } END { print max }')
    separator=$(printf '%*s' "$max_width" '' | tr ' ' '-')
    table=$(printf "%s\n%s\n%s" "$header_line" "$separator" "$(echo "$table" | tail -n +2 | sed 's/~/ /g')")
    echo "$table" | gum style \
        --border rounded \
        --border-foreground "#7D56F4" \
        --padding "0 1"
}

# ============================================================================
# Subcommand: caddy-sync
# ============================================================================

# Regenerate every hostname snippet from the worktrees on disk, drop snippets
# for workspaces that no longer exist, and reload Caddy. Backfills workspaces
# created before hostnames existed and repairs drift. Read-only with respect
# to the worktrees themselves — it only reads each one's .env.
cmd_caddy_sync() {
    local dir
    dir=$(caddy_dir)
    mkdir -p "$dir"

    local expected=()
    local written=0 unchanged=0 removed=0
    local rows=""

    for project in $(list_projects); do
        get_project_paths "$project"

        local worktrees
        worktrees=$(git -C "$PROJECT_PATH" worktree list 2>/dev/null || true)
        [[ -z "$worktrees" ]] && continue

        # "<key> <path>" per workspace: main (if initialized) then worktrees
        local entries=""
        if [[ -f "$PROJECT_PATH/Procfile.workspace" ]]; then
            entries="main $PROJECT_PATH"$'\n'
        fi
        while IFS= read -r line; do
            local path
            path=$(echo "$line" | awk '{print $1}')
            [[ "$path" == "$PROJECT_PATH" ]] && continue
            entries+="$(basename "$path") $path"$'\n'
        done <<< "$worktrees"

        while read -r key path; do
            [[ -n "$key" ]] || continue
            local port
            port=$(workspace_rails_port "$path")
            [[ -n "$port" ]] || continue

            expected+=("$(caddy_snippet_path "$project" "$key")")
            if write_caddy_snippet "$project" "$key" "$port"; then
                written=$((written + 1))
            else
                unchanged=$((unchanged + 1))
            fi
            rows+="$project,$key,$(workspace_hostname "$project" "$key"),$port"$'\n'
        done <<< "$entries"
    done

    # Remove managed snippets for workspaces that no longer exist. Files
    # without the managed marker were put there by hand and are left alone.
    local f e keep
    for f in "$dir"/*.caddy; do
        [[ -f "$f" ]] || continue
        grep -qs "^$CADDY_MANAGED_MARK" "$f" || continue
        keep=false
        for e in "${expected[@]}"; do
            if [[ "$e" == "$f" ]]; then
                keep=true
                break
            fi
        done
        if [[ "$keep" == false ]]; then
            rm -f "$f"
            removed=$((removed + 1))
        fi
    done

    echo -e "${GREEN}Caddy snippets synced:${NC} $dir"
    echo -e "  Written: $written   Unchanged: $unchanged   Removed: $removed"
    echo ""

    if [[ -n "$rows" ]]; then
        local table header_line separator max_width
        table=$(printf "Project,Workspace,Host,Rails\n%s" "$rows" | column -t -s,)
        header_line=$(echo "$table" | head -1)
        max_width=$(echo "$table" | awk '{ if (length > max) max = length } END { print max }')
        separator=$(printf '%*s' "$max_width" '' | tr ' ' '-')
        table=$(printf "%s\n%s\n%s" "$header_line" "$separator" "$(echo "$table" | tail -n +2)")
        echo "$table" | gum style \
            --border rounded \
            --border-foreground "#7D56F4" \
            --padding "0 1"
        echo ""
    fi

    caddy_reload
}

# ============================================================================
# Resume all workspaces
# ============================================================================

cmd_resume_all() {
    local projects
    projects=$(list_projects)

    local to_resume=()
    local already_running=()

    for project in $projects; do
        get_project_paths "$project"

        local worktrees
        worktrees=$(git -C "$PROJECT_PATH" worktree list 2>/dev/null || true)
        [[ -z "$worktrees" ]] && continue

        # Check main workspace
        if [[ -f "$PROJECT_PATH/Procfile.workspace" ]]; then
            local main_session="${project}-main"
            if tmux has-session -t "$main_session" 2>/dev/null; then
                already_running+=("$project/main")
            else
                to_resume+=("$project main")
            fi
        fi

        # Check feature worktrees
        local workspace_worktrees
        workspace_worktrees=$(echo "$worktrees" | grep -v "^$PROJECT_PATH " || true)

        if [[ -n "$workspace_worktrees" ]]; then
            while IFS= read -r line; do
                local path
                path=$(echo "$line" | awk '{print $1}')

                local feature
                feature=$(basename "$path")

                local tmux_session="${project}-${feature}"
                if tmux has-session -t "$tmux_session" 2>/dev/null; then
                    already_running+=("$project/$feature")
                else
                    to_resume+=("$project $feature")
                fi
            done <<< "$workspace_worktrees"
        fi
    done

    if [[ ${#to_resume[@]} -eq 0 && ${#already_running[@]} -eq 0 ]]; then
        echo "No workspaces found."
        return
    fi

    if [[ ${#already_running[@]} -gt 0 ]]; then
        echo -e "${BLUE}Already running:${NC}"
        for item in "${already_running[@]}"; do
            echo -e "  $item"
        done
        echo ""
    fi

    if [[ ${#to_resume[@]} -eq 0 ]]; then
        echo "All workspaces are already running."
        return
    fi

    echo -e "${GREEN}Resuming ${#to_resume[@]} workspace(s)...${NC}"
    echo ""

    local resumed=0
    for item in "${to_resume[@]}"; do
        local project feature
        project=$(echo "$item" | awk '{print $1}')
        feature=$(echo "$item" | awk '{print $2}')

        echo -e "${CYAN}━━━ $project / $feature ━━━${NC}"
        cmd_resume "$project" "$feature"
        resumed=$((resumed + 1))
        echo ""
    done

    echo -e "${GREEN}Done! Resumed $resumed workspace(s).${NC}"
}

# ============================================================================
# Main
# ============================================================================

# The tmux choose-tree line format that surfaces @agent_status in the session
# chooser (prefix + s).
#
# choose-tree builds each line as "(key) + <session_name>: " and only THEN
# appends this format, so anything here lands to the right of a name whose
# width varies — there is no way to get the glyph into a flush-left column
# short of -K, which would cost the (0)-(9) jump keys. So this stays lean and
# says only what the name and the tree prefix don't: the glyph, and whether
# the session is attached. Repeating #{session_name} here just printed it
# twice, and the window count was noise crowding the glyph.
#
# The nested conditional keeps the spacing right in all four combinations:
# "▲ (attached)", "▲", "(attached)", "".
readonly TMUX_CHOOSER_FORMAT='#{?#{@agent_status},#{@agent_status}#{?session_attached, ,},}#{?session_attached,(attached),}'

# Install Claude Code hooks into ~/.claude/settings.json so that every claude
# session records its current state in its tmux session's @agent_status option.
# That option feeds both the tmux session chooser and `workspace list`.
# Idempotent: re-running replaces our own entries and leaves other hooks intact.
cmd_install_hooks() {
    local settings="$HOME/.claude/settings.json"

    if ! command -v jq &>/dev/null; then
        echo -e "${RED}jq is required to install hooks.${NC} Install it with: brew install jq"
        exit 1
    fi

    mkdir -p "$HOME/.claude"
    [[ -f "$settings" ]] || echo '{}' > "$settings"

    if ! jq empty "$settings" 2>/dev/null; then
        echo -e "${RED}$settings is not valid JSON; refusing to modify it.${NC}"
        exit 1
    fi

    # Each hook sets the status glyph on its own tmux session (found via the
    # inherited $TMUX_PANE), so nothing happens when claude runs outside tmux.
    # The trailing comment tags our commands so re-installs can find/replace them.
    local pre='[ -n "$TMUX_PANE" ] && tmux set-option -t "$TMUX_PANE" @agent_status "'
    local suf='" 2>/dev/null # workspace-tool-agent-state'

    # Stop is the exception to the pre/suf shape, so it gets spelled out in
    # full. A turn also "ends" while claude sits waiting on background work (a
    # detached shell job, a subagent, a workflow) — that is paused, not done,
    # and painting ▲ there says "needs you" when nothing does. Claude Code
    # hands the Stop hook a background_tasks[] array on stdin for exactly this
    # distinction; non-empty means in flight. It is optional in the schema, so
    # a missing key has to read as empty. If jq isn't on the session's PATH the
    # && never fires and the glyph falls back to ▲ — the old behaviour.
    local stop='g=▲; jq -e "(.background_tasks // []) | length > 0" >/dev/null 2>&1 && g=◇; [ -n "$TMUX_PANE" ] && tmux set-option -t "$TMUX_PANE" @agent_status "$g" 2>/dev/null # workspace-tool-agent-state'

    local tmp
    tmp=$(mktemp)
    if jq \
        --arg working "${pre}●${suf}" \
        --arg needs   "${pre}▲${suf}" \
        --arg idle    "${pre}○${suf}" \
        --arg clear   "${pre}${suf}" \
        --arg stop    "$stop" \
        '
        def group(cmd): { hooks: [ { type: "command", command: cmd } ] };
        def mine: ([.hooks[]?.command // ""] | any(test("workspace-tool-agent-state")));
        .hooks //= {}
        | .hooks |= with_entries(.value |= map(select(mine | not)))
        | .hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) + [group($working)])
        | .hooks.PostToolUse      = ((.hooks.PostToolUse      // []) + [group($working)])
        | .hooks.Notification     = ((.hooks.Notification     // []) + [group($needs)])
        | .hooks.Stop             = ((.hooks.Stop             // []) + [group($stop)])
        | .hooks.SessionStart     = ((.hooks.SessionStart     // []) + [group($idle)])
        | .hooks.SessionEnd       = ((.hooks.SessionEnd       // []) + [group($clear)])
        ' "$settings" > "$tmp" && [[ -s "$tmp" ]]; then
        mv "$tmp" "$settings"
    else
        rm -f "$tmp"
        echo -e "${RED}Failed to update $settings${NC}"
        exit 1
    fi

    echo -e "${GREEN}Installed agent-status hooks in $settings${NC}"
    echo ""
    echo "  ● working    a prompt is being worked on"
    echo "  ▲ needs you  waiting on permission, or the turn just finished"
    echo "  ◇ waiting    paused on background work (CI, deploy, subagent)"
    echo "  ○ idle       session started, nothing in flight"
    echo ""
    echo "Status now shows in 'workspace list'. To also show it in the tmux"
    echo "session chooser (prefix + s), add this to your ~/.tmux.conf:"
    echo ""
    echo -e "  ${BLUE}bind s choose-tree -Zs -F \"$TMUX_CHOOSER_FORMAT\"${NC}"
    echo ""
    echo -e "${YELLOW}Only claude sessions started from now on will report status.${NC}"
    echo "Restart claude in any running workspace to pick it up."
}

usage() {
    echo "Usage: workspace <command> [args]"
    echo ""
    echo "Commands:"
    echo "  new <project> <feature>      Create a new workspace (new branch off master)"
    echo "  new <project> <feature> --existing  Create a workspace from an existing local branch"
    echo "  new <project> main           Initialize the main checkout as a workspace"
    echo "  pull <project> <branch>      Pull a remote branch into a new workspace"
    echo "  resume <project> [feature]   Resume workspace(s) (all for project if no feature given)"
    echo "  resume --all                 Resume all workspaces (useful after reboot)"
    echo "  stop <project> [feature]     Stop workspace(s) without deleting (all for project if no feature given)"
    echo "  delete <project> <feature>   Delete a workspace"
    echo "  info                         Show info about the current workspace"
    echo "  list [project] [--pr] [--running] [--recent]  List workspaces (--pr for PR status, --running for active only, --recent to sort by last active)"
    echo "  ports [--running]            Show all port and Redis allocations (--running for active only)"
    echo "  caddy-sync                   Regenerate Caddy hostname snippets from the worktrees on disk"
    echo "  install-hooks                Install Claude Code hooks so 'list' can show agent status"
    echo ""
    echo "Examples:"
    echo "  workspace new tract main"
    echo "  workspace new tract my-feature"
    echo "  workspace new tract my-feature --existing"
    echo "  workspace pull tract remote-branch"
    echo "  workspace resume tract my-feature"
    echo "  workspace resume tract"
    echo "  workspace stop tract my-feature"
    echo "  workspace stop tract"
    echo "  workspace delete tract my-feature"
    echo "  workspace list"
    echo "  workspace list tract"
    echo ""
    echo "Config file: $CONFIG_FILE"
}

main() {
    local command="$1"
    shift || true

    case "$command" in
        new)
            check_config
            cmd_new "$@"
            ;;
        pull)
            check_config
            cmd_pull "$@"
            ;;
        resume)
            check_config
            cmd_resume "$@"
            ;;
        resume-all)
            check_config
            cmd_resume --all
            ;;
        stop)
            check_config
            cmd_stop "$@"
            ;;
        delete)
            check_config
            cmd_delete "$@"
            ;;
        info)
            check_config
            cmd_info
            ;;
        list)
            check_config
            cmd_list "$@"
            ;;
        ports|redis)
            check_config
            cmd_ports "$@"
            ;;
        caddy-sync)
            check_config
            cmd_caddy_sync
            ;;
        install-hooks)
            cmd_install_hooks
            ;;
        -h|--help|"")
            usage
            ;;
        *)
            echo -e "${RED}Unknown command: $command${NC}"
            echo ""
            usage
            exit 1
            ;;
    esac
}

main "$@"
